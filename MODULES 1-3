Пункт 10. Инфраструктура разрешения доменных имён
Основной DNS-сервер развёрнут на HQ-SRV (пакет bind). Обеспечивается прямое и обратное разрешение имён. Форвардеры: 77.88.8.7 и 77.88.8.3.
apt-get install -y bind bind-utils
vim /etc/bind/named.conf


Конфигурация /etc/bind/named.conf:
options {
    directory "/var/named";
    listen-on { any; };
    allow-query { any; };
    recursion yes;
    forwarders { 77.88.8.7; 77.88.8.3; };
};

zone "au-team.irpo" IN {
    type master;
    file "/var/named/au-team.irpo.zone";
    allow-update { none; };
};

zone "100.168.192.in-addr.arpa" IN {
    type master;
    file "/var/named/192.168.100.rev";
};

zone "200.168.192.in-addr.arpa" IN {
    type master;
    file "/var/named/192.168.200.rev";
};

