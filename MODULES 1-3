# Монтируем:
mkdir -p /raid1

# Добавляем в /etc/fstab:
# /dev/md0  /raid1  ext3  defaults  0  2

mount -a
df -h | grep raid1
# /dev/md0  ..  /raid1

# Статус RAID:
